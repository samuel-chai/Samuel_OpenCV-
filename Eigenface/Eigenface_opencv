import cv2
import numpy as np
import os
import matplotlib.pyplot as plt

# 設定人臉圖片資料夾
DATASET_PATH = "att_faces"  # 下載後放這裡，裡面有 s1 到 s40 資料夾

def read_images(path, size=(92, 112)):
    X, y = [], []
    label = 0
    for dirname in sorted(os.listdir(path)):
        subject_path = os.path.join(path, dirname)
        if not os.path.isdir(subject_path):
            continue
        for filename in os.listdir(subject_path):
            img_path = os.path.join(subject_path, filename)
            img = cv2.imread(img_path, cv2.IMREAD_GRAYSCALE)
            if img is None:
                continue
            img = cv2.resize(img, size)
            X.append(np.asarray(img, dtype=np.uint8))
            y.append(label)
        label += 1
    return [X, y]

print("[INFO] 讀取圖片資料...")
[X, y] = read_images(DATASET_PATH)

print("[INFO] 計算 Eigenfaces...")
height, width = X[0].shape
X_matrix = np.asarray([x.flatten() for x in X])
mean, eigenvectors = cv2.PCACompute(X_matrix, mean=None, maxComponents=10)

def plot_eigenfaces(mean, eigenvectors, height, width):
    plt.figure(figsize=(10, 5))
    plt.subplot(2, 5, 1)
    plt.imshow(mean.reshape((height, width)), cmap='gray')
    plt.title("Mean Face")
    plt.axis('off')
    for i in range(9):
        plt.subplot(2, 5, i + 2)
        plt.imshow(eigenvectors[i].reshape((height, width)), cmap='gray')
        plt.title(f"eigenface {i+1}")
        plt.axis('off')
    plt.tight_layout()
    plt.show()

plot_eigenfaces(mean, eigenvectors, height, width)